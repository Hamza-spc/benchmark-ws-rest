        <hashTree/>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="HEAVY-body 30 threads" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>

s = s.replace('__CAT__', vars.get('cat_id') ?: '1')
s = s.replace('__BASE__', vars.get('baseUrl') ?: 'http://localhost:8082')
vars.put('requestBody', s)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
